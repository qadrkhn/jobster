# .editorconfig for frontend (React.js)

[*]
indent_style = space
indent_size = 2               
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
charset = utf-8

# JavaScript & JSX/TSX files
[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100
quote_type = double           # Prefer double quotes for JavaScript/JSX

# JSON files
[*.json]
indent_size = 2
insert_final_newline = ignore

[*.md]
max_line_length = 80       
indent_size = 2             

# Stylelint Configuration (if you're using Stylelint for CSS or SCSS)
[**/*.css]
indent_size = 2
insert_final_newline = true

[**/*.scss]
indent_size = 2
insert_final_newline = true

# For preprocessed files like SASS or SCSS, use 2 spaces and ensure final newline
[*.scss]
indent_size = 2

# For .html files (if you have any)
[*.html]
indent_size = 2               
insert_final_newline = true
